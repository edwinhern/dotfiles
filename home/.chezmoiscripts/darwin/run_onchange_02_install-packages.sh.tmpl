#!/usr/bin/env bash
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

{{ if eq .chezmoi.os "darwin" }}
{{ template "lib/common/log.sh" . }}
{{ template "lib/common/install-prelude.sh" . }}
HOMEBREW_BUNDLE_CONTENT=$(cat <<'BREWFILE'
{{- $brew := .packages.darwin.homebrew -}}
{{ range $brew.taps }}tap "{{ . }}"
{{ end -}}
{{ range $brew.formulas }}brew "{{ . }}"
{{ end -}}
{{ range $brew.casks }}cask "{{ . }}"
{{ end -}}
{{ range $brew.mas }}mas "{{ .name }}", id: {{ .id }}
{{ end -}}
BREWFILE
)
{{ template "lib/install/homebrew-bundle.sh" . }}
{{ end }}
