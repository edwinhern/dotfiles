#!/usr/bin/env bash
# @file run_onchange_07_install-ai-skills.sh
# @brief Install cross-agent AI skills.
# @description AI data hash: {{ include ".chezmoidata/ai.yaml" | sha256sum }}; local skills hash: {{ $h := "" }}{{ range (glob (joinPath .chezmoi.sourceDir ".chezmoitemplates" "skills" "**" "SKILL.md")) }}{{ $h = print $h (include .) }}{{ end }}{{ $h | sha256sum }}

{{ if and (eq .chezmoi.os "darwin") (gt (len .ai.targets) 0) (gt (len .ai.skills) 0) }}
{{ template "lib/common/log.sh" . }}
{{ template "lib/common/install-prelude.sh" . }}
export AI_LOCAL_SKILLS_DIR="{{ .chezmoi.sourceDir }}/.chezmoitemplates/skills"
AI_SKILL_TARGETS=(
{{ range .ai.targets -}}
  "{{ . }}"
{{ end -}}
)
AI_SKILLS=(
{{ range .ai.skills -}}
  "{{ .source }}|{{ .skill }}"
{{ end -}}
)
{{ template "lib/install/ai-skills.sh" . }}
{{ end }}
