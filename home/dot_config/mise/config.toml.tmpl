[tools]
{{ $groups := list "shared" -}}
{{ if .personal }}{{ $groups = append $groups "personal" }}{{ end -}}
{{ if .work }}{{ $groups = append $groups "work" }}{{ end -}}
{{ range $groups -}}
{{ $tools := index $.mise.tools . -}}
{{ range $tools -}}
"{{ .name }}" = "{{ .version }}"
{{ end -}}
{{ end }}

[settings]
idiomatic_version_file_enable_tools = ["node", "python", "pnpm"]
trusted_config_paths = ["/"]
