{{- $groups := list "shared" -}}
{{- if .personal }}{{ $groups = append $groups "personal" }}{{ end -}}
{{- if .work     }}{{ $groups = append $groups "work"     }}{{ end -}}
name: development
version: 1.0.0
description: APM project for development
target:
{{ range $groups -}}
{{ $targets := index $.apm.targets . -}}
{{ range $targets }}  - {{ . }}
{{ end -}}
{{ end -}}
author: Edwin Hernandez
includes: auto
dependencies:
  apm:
{{ range $groups }}
{{- $dependencies := index $.apm.dependencies . }}
{{ range $dependencies }}
    - {{ . }}
{{ end }}
{{ end -}}
  mcp:
{{ range $groups -}}
{{- $servers := index $.apm.mcp . -}}
{{ range $servers -}}
{{ includeTemplate "apm/mcp-server.yml.tmpl" . | trim | indent 4 }}
{{ end -}}
{{ end -}}
